# URL de base de l'application (liens WhatsApp, QR codes et PWA)
APP_URL=http://localhost:3000

# Numéro de support WhatsApp (ex: +221771234567)
SUPPORT_WHATSAPP=+221770000000

# Numéro Wave pour recevoir les paiements d'abonnements Pro/Pro+
BILLING_WAVE_NUMBER=+221770000000

# Liste des numéros de téléphones administrateurs séparés par des virgules
ADMIN_PHONES=+221771234567,+221781234567

# URL publique optionnelle du bucket R2 médias pour servir les images directement via CDN R2
# Ex: https://images.jaayma.sn ou https://pub-<hash>.r2.dev
# Laisser vide en local (utilise la route /api/images/ servie par le Worker via binding MEDIA_BUCKET)
NEXT_PUBLIC_R2_PUBLIC_URL=

# Mesure Google Analytics (optionnel, configuré également dans wrangler.jsonc)
GA_MEASUREMENT_ID=G-2SVKFRMHT3

# Clés VAPID pour les notifications Push Web (générées via web-push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@jaayma.sn

# -----------------------------------------------------------------------------
# VARIABLES DEPRECATED / SUPPRIMÉES (remplacées par Cloudflare D1 local)
# -----------------------------------------------------------------------------
# API_BASE_URL (supprimé : aucun backend externe requis)
# NEXT_PUBLIC_API_URL (supprimé : aucun backend externe requis)
